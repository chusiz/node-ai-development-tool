{
  "name": "node-ai-development-tool-demo-app",
  "version": "1.0.0",
  "description": "chusiz 全流程验证应用:展示图像节点产出的 UI 素材",
  "main": "main.js",
  "author": "chusiz",
  "build": {
    "appId": "com.chusiz.demo",
    "productName": "ChusizDemo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "ChusizDemo.exe"
    }
  },
  "devDependencies": {
    "electron": "38.8.6"
  }
}
