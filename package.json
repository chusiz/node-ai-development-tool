{
  "name": "node-ai-development-tool",
  "version": "0.6.6",
  "private": true,
  "description": "节点式 AI 软件/应用/游戏制作工作台:本地模型直出生图、交接节点、Electron exe 打包、视频理解",
  "productName": "Node AI Development Tool",
  "main": "./out/main/index.js",
  "author": "haowan",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=.tmp/e2e.cjs --log-level=warning && node .tmp/e2e.cjs",
    "sd:status": "esbuild scripts/sd-local.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=.tmp/sd-local.cjs --log-level=warning && node .tmp/sd-local.cjs status",
    "sd:start": "esbuild scripts/sd-local.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=.tmp/sd-local.cjs --log-level=warning && node .tmp/sd-local.cjs start",
    "sd:stop": "esbuild scripts/sd-local.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=.tmp/sd-local.cjs --log-level=warning && node .tmp/sd-local.cjs stop",
    "fullflow": "esbuild scripts/fullflow.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=.tmp/fullflow.cjs --log-level=warning && node .tmp/fullflow.cjs",
    "verify": "npm run typecheck && npm run e2e",
    "probe": "electron-vite build && node scripts/probe.mjs",
    "mcp": "esbuild src/main/mcp/standalone.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=.tmp/mcp-standalone.cjs --log-level=warning && node .tmp/mcp-standalone.cjs",
    "icon": "node scripts/makeIcon.mjs",
    "dist": "npm run icon && electron-vite build && electron-builder --win",
    "dist:portable": "npm run dist && node scripts/portable.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "adm-zip": "^0.6.1",
    "echarts": "^6.1.0",
    "electron-log": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "38.8.6",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.nodeai.developmenttool",
    "productName": "Node AI Development Tool",
    "copyright": "Copyright © 2026 chusiz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "node-ai-development-tool-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Node AI Development Tool",
      "deleteAppDataOnUninstall": false
    }
  }
}
